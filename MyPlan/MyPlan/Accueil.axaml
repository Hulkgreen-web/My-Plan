<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyPlan.Accueil"
        Title="Accueil - My Plan"
        Height="500" Width="700"
        Background="#FFF9F5"
        FontFamily="Georgia"
        FontSize="14"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Style unifié pour tous les boutons du menu -->
        <Style Selector="Button.MenuButton">
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Effet survol : conserve la couleur de fond spécifique du bouton et applique l'opacité 0.9 -->
        <Style Selector="Button.MenuButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#FFA726" CornerRadius="6" Padding="15" Margin="0,0,0,25">
            <TextBlock Text="My Plan" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"
                       FontFamily="Verdana"/>
        </Border>

        <!-- Contenu principal - disposition en 2 colonnes -->
        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Colonne gauche -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                <Button Content="Commencer à gérer mon budget" 
                        Classes="MenuButton"
                        Background="#FB8C00"
                        Click="StartBudget_Click"/>

                <Button Content="Visualiser les revenus" 
                        Classes="MenuButton"
                        Background="#FFB74D"
                        Click="OuvrirRevenus_Click"/>

                <Button Content="Visualiser les dépenses"
                        Classes="MenuButton"
                        Background="#FFCC80"
                        Click="OuvrirDepenses_Click"/>
            </StackPanel>

            <!-- Colonne droite -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                <Button Content="Gérer les épargnes"
                        Classes="MenuButton"
                        Background="#E65100"
                        Click="OuvrirEpargnes_Click"/>

                <Button Content="Gérer le solde" 
                        Classes="MenuButton"
                        Background="#F57C00"
                        Click="ManageBalance_Click"/>

                <Button Content="Quitter"
                        Classes="MenuButton"
                        Background="#FFA726"
                        Click="Quit_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
