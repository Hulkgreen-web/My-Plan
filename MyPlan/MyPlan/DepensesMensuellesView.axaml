<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        x:Class="MyPlan.DepensesMensuellesView"
        Title="Dépenses Mensuelles" Height="550" Width="950"
        Loaded="Window_Loaded"
        Background="#FFF9F5" FontFamily="Georgia" FontSize="14"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFCC80"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFCC80"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFA726"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Styles>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titre -->
            <RowDefinition Height="Auto"/>
            <!-- Filtres -->
            <RowDefinition Height="*"/>
            <!-- Contenu -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" 
                Background="#FFA726" Padding="10" Margin="0,0,0,10" CornerRadius="4">
            <TextBlock Text="Analyse des Dépenses Mensuelles" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"
                       FontFamily="Verdana"/>
        </Border>

        <!-- Filtres -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,15">
            <TextBlock Text="Mois :" VerticalAlignment="Center" 
                      Foreground="#E65100" FontWeight="Bold"/>
            <ComboBox x:Name="MoisComboBox" Width="140" 
                      SelectionChanged="ComboBoxDate_SelectionChanged" 
                      Margin="5,0"/>

            <TextBlock Text="Année :" VerticalAlignment="Center" 
                      Foreground="#E65100" FontWeight="Bold" 
                      Margin="10,0,0,0"/>
            <ComboBox x:Name="AnneeComboBox" Width="120" 
                      SelectionChanged="ComboBoxDate_SelectionChanged" 
                      Margin="5,0"/>

            <Button Content="Accueil" 
                    Background="#FB8C00" 
                    Click="RetourAccueil_Click" 
                    Margin="20,0,0,0"/>
        </StackPanel>

        <!-- DataGrid -->
        <Border Grid.Row="2" Grid.Column="0" Background="White" BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
            <DataGrid x:Name="DepensesParCategorieDataGrid"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Catégorie" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="Montant estimé (€)" Binding="{Binding MontantEstime, StringFormat=\{0:N2\}}" Width="*" CellStyleClasses="RightAlignedText"/>
                    <DataGridTextColumn Header="Montant réel (€)" Binding="{Binding MontantReel, StringFormat=\{0:N2\}}" Width="*" CellStyleClasses="RightAlignedText"/>
                    <DataGridTextColumn Header="Écart (€)" Binding="{Binding Ecart, StringFormat=\{0:N2\}}" Width="*" CellStyleClasses="RightAlignedText"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Graphique -->
        <Border Grid.Row="2" Grid.Column="1" Background="White" BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="4" Padding="10">
            <lvc:PieChart x:Name="DepensesPieChart"
                          LegendPosition="Bottom" />
        </Border>
    </Grid>
</Window>
